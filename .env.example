# Environment Variables for Streamlit Stock ML App
# Copy this to .env and fill in actual values

# ========== App Configuration ==========
APP_NAME=Equity Data Platform
APP_ENV=development
LOG_LEVEL=INFO

# ========== Database Configuration ==========
# DuckDB (Phase 1 - embedded, file-based)
DUCKDB_PATH=data/app.duckdb

# PostgreSQL (Phase 2 - optional, for multi-service setup)
# POSTGRES_URL=postgresql://user:password@postgres:5432/equity_db
# POSTGRES_USER=equity_user
# POSTGRES_PASSWORD=equity_password

# ========== Streamlit Configuration ==========
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLEXSRFPROTECTION=true

# ========== Authentication (Google OAuth) ==========
# Leave as-is for dev mode (auth.py has fallback when secrets missing)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8501

# ========== Data Configuration ==========
# Symbols to fetch from yfinance
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,TSLA,SPY,QQQ
DEFAULT_PERIOD=5d
DEFAULT_INTERVAL=5m
WARMUP_PERIOD=60d

# ========== Airflow Configuration (Phase 2) ==========
# AIRFLOW_HOME=/airflow
# AIRFLOW_UID=50000
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow_db
# AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
# AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql+psycopg2://airflow:airflow@postgres:5432/airflow_db

# ========== Redis Configuration (Phase 2) ==========
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=

# ========== Ollama Configuration (Future - RAG/Chat) ==========
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2
